rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para ejercicios del usuario
    match /users/{userId}/exercises/{exerciseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para rutinas de entrenamiento del usuario
    match /users/{userId}/workouts/{workoutId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para recetas del usuario
    match /users/{userId}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para progreso del usuario
    match /users/{userId}/progress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para datos de fitness del usuario
    match /users/{userId}/fitness/{fitnessId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Métricas de capacidades / RM (colección top-level con userId en el documento)
    match /user_metrics/{metricId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}